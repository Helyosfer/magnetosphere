{
  "manifest_version": 3,
  "name": "Magnetosphere",
  "version": "0.3.1",
  "description": "Mod ekibinle ortak ban listesi tut; bir kullanıcıyı ekibin tüm Kick kanallarında tek tıkla banla.",
  "permissions": [
    "identity",
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_title": "Magnetosphere",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
