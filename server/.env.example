# Bu dosyayı .env adıyla kopyalayıp doldurun.

# Kick > Ayarlar > Developer bölümünde oluşturduğunuz uygulamanın bilgileri
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Sunucunun dışarıdan erişilen adresi. Kick uygulamasındaki Redirect URL
# tam olarak {PUBLIC_URL}/auth/callback olmalı.
PUBLIC_URL=http://localhost:8787

HOST=127.0.0.1
PORT=8787

# Yalnızca bu extension kimliklerinden giriş ve API çağrısı kabul edilir (virgülle ayırın).
# Depodaki extension'ın kimliği sabittir:
ALLOWED_EXTENSION_IDS=flmfmniipeobbaoahmbdkjnblbegalob

# Kick tokenlarını veritabanında şifreleyen anahtar. Üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kaybolursa herkesin yeniden giriş yapması gerekir. Boş bırakılırsa tokenlar düz metin kalır.
TOKEN_ENCRYPTION_KEY=
